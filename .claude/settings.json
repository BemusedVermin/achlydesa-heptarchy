{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(go tool task *)",
      "Bash(go test *)",
      "Bash(go build *)",
      "Bash(go vet *)",
      "Bash(go run ./*)",
      "Bash(go doc *)",
      "Bash(go list *)",
      "Bash(go env *)",
      "Bash(go version)",
      "Bash(go mod tidy)",
      "Bash(gofmt *)",
      "Bash(golangci-lint *)",
      "Bash(go install github.com/golangci/golangci-lint/v2/cmd/golangci-lint@*)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git blame *)",
      "Bash(git grep *)",
      "Bash(git ls-files *)",
      "Bash(git rev-parse *)",
      "Bash(git for-each-ref *)",
      "Bash(git branch *)",
      "Bash(git switch *)",
      "Bash(git checkout *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git fetch *)",
      "Bash(git rebase *)",
      "Bash(git merge *)",
      "Bash(git push *)",
      "Bash(git restore *)",
      "Bash(git stash *)",
      "Bash(git mv *)",
      "Bash(git rm *)",
      "Bash(git remote -v)",
      "Bash(git worktree list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr create *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr status *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh api *)",
      "PowerShell(go tool task *)",
      "PowerShell(go test *)",
      "PowerShell(go build *)",
      "PowerShell(go vet *)",
      "PowerShell(go run ./*)",
      "PowerShell(go doc *)",
      "PowerShell(go list *)",
      "PowerShell(go env *)",
      "PowerShell(go version)",
      "PowerShell(go mod tidy)",
      "PowerShell(gofmt *)",
      "PowerShell(golangci-lint *)",
      "PowerShell(go install github.com/golangci/golangci-lint/v2/cmd/golangci-lint@*)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",
      "PowerShell(git show *)",
      "PowerShell(git blame *)",
      "PowerShell(git grep *)",
      "PowerShell(git ls-files *)",
      "PowerShell(git rev-parse *)",
      "PowerShell(git for-each-ref *)",
      "PowerShell(git branch *)",
      "PowerShell(git switch *)",
      "PowerShell(git checkout *)",
      "PowerShell(git add *)",
      "PowerShell(git commit *)",
      "PowerShell(git fetch *)",
      "PowerShell(git rebase *)",
      "PowerShell(git merge *)",
      "PowerShell(git push *)",
      "PowerShell(git restore *)",
      "PowerShell(git stash *)",
      "PowerShell(git mv *)",
      "PowerShell(git rm *)",
      "PowerShell(git remote -v)",
      "PowerShell(git worktree list *)",
      "PowerShell(gh pr view *)",
      "PowerShell(gh pr list *)",
      "PowerShell(gh pr create *)",
      "PowerShell(gh pr diff *)",
      "PowerShell(gh pr checks *)",
      "PowerShell(gh pr status *)",
      "PowerShell(gh run list *)",
      "PowerShell(gh run view *)",
      "PowerShell(gh api *)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git reset --hard *)",
      "Bash(gh pr merge *)",
      "Bash(gh repo delete *)",
      "PowerShell(git push --force *)",
      "PowerShell(git push -f *)",
      "PowerShell(git push --force-with-lease *)",
      "PowerShell(git reset --hard *)",
      "PowerShell(gh pr merge *)",
      "PowerShell(gh repo delete *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "go",
            "args": [
              "-C",
              "${CLAUDE_PROJECT_DIR}",
              "run",
              "./internal/tools/agentkit",
              "guard"
            ],
            "timeout": 60,
            "statusMessage": "Agent guardrails"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "go",
            "args": [
              "-C",
              "${CLAUDE_PROJECT_DIR}",
              "run",
              "./internal/tools/agentkit",
              "protect"
            ],
            "timeout": 60,
            "statusMessage": "Agent guardrails"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "go",
            "args": [
              "-C",
              "${CLAUDE_PROJECT_DIR}",
              "run",
              "./internal/tools/agentkit",
              "after-edit"
            ],
            "timeout": 120,
            "statusMessage": "Formatting and linting the edited Go file"
          }
        ]
      }
    ]
  }
}
