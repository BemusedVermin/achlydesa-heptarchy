# Store LF in the repo and check out LF everywhere, Windows included.
# gofmt writes LF, so this avoids whole-file diffs flipping between CRLF and LF.
* text=auto eol=lf

# Windows script files keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Generated code: collapsed in GitHub diffs, left out of language stats.
content/schema/** linguist-generated=true
*.pb.go           linguist-generated=true

# Binary assets: never diffed or converted.
*.png binary
*.ttf binary
*.wav binary
*.ogg binary